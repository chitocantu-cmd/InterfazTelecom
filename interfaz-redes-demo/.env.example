# Copie este archivo como .env.local (NO como .env, que se sube a GitHub y el repositorio es público).
# Las claves (RESEND_API_KEY, WHATSAPP_TOKEN) nunca van en .env.

# URL pública definitiva (canonical, sitemap y Open Graph)
VITE_SITE_URL=https://interfaztelecom.com.mx
# Google Analytics 4 (opcional). Sin valor, no se carga ningún script de medición.
VITE_GA_ID=

# ---------------------------------------------------------------------------------------------
# Recepción de cotizaciones (/api/cotizacion). Variables del SERVIDOR: van en Vercel → Settings →
# Environment Variables (o en .env.local para probar en local). Nunca en .env ni con prefijo VITE_.
# Sin RESEND_API_KEY ni WhatsApp configurado, el cotizador sigue con el envío manual (WhatsApp/correo).
# ---------------------------------------------------------------------------------------------

# Correo (Resend · https://resend.com → API Keys). Secreto.
RESEND_API_KEY=
# Remitente: su dominio debe estar verificado en Resend.
COTIZACION_REMITENTE=Interfaz Redes <cotizaciones@interfaztelecom.com.mx>
# Quién recibe cada solicitud (separe varios con coma). Por omisión: ventas@interfaz.com.mx
COTIZACION_DESTINATARIOS=ventas@interfaz.com.mx
# Reply-To del acuse al cliente (a dónde llega si el cliente contesta).
COTIZACION_RESPONDER_A=ventas@interfaz.com.mx
# Acuse de recibo al cliente: 1 = sí (por omisión), 0 = no.
COTIZACION_ACUSE=1
# Solicitudes permitidas por IP en 10 minutos.
COTIZACION_LIMITE_POR_IP=5

# WhatsApp Business Platform · Cloud API de Meta (https://developers.facebook.com → su app → WhatsApp).
# Token permanente de un usuario del sistema con permiso whatsapp_business_messaging. Secreto.
WHATSAPP_TOKEN=
# "Phone number ID" del número de WhatsApp Business que envía los avisos.
WHATSAPP_PHONE_NUMBER_ID=
# Números que reciben el aviso, con lada de país y sin "+" (separe varios con coma).
WHATSAPP_DESTINATARIOS=
# Plantilla aprobada en WhatsApp Manager (texto en el README) e idioma.
WHATSAPP_PLANTILLA=nueva_cotizacion
WHATSAPP_PLANTILLA_IDIOMA=es_MX
WHATSAPP_API_VERSION=v23.0

# Sólo en local: 1 escribe los correos y el aviso en .cotizaciones-prueba/ en lugar de enviarlos.
# No tiene efecto en Vercel.
COTIZACION_PRUEBA=
