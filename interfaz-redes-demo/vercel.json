{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "functions": { "api/cotizacion.ts": { "maxDuration": 60 } },
  "trailingSlash": false,
  "redirects": [
    { "source": "/servicios", "destination": "/soluciones", "permanent": true },
    { "source": "/servicios/:path*", "destination": "/soluciones", "permanent": true },
    { "source": "/home", "destination": "/", "permanent": true },
    { "source": "/inicio", "destination": "/", "permanent": true },
    { "source": "/cotizar", "destination": "/contacto", "permanent": true },
    { "source": "/privacidad", "destination": "/aviso-de-privacidad", "permanent": true },
    { "source": "/soluciones/switching-routing", "destination": "/soluciones/redes-empresariales", "permanent": true },
    { "source": "/:path*", "has": [{ "type": "host", "value": "interfaz-redes.vercel.app" }], "destination": "https://interfaztelecom.com.mx/:path*", "permanent": true }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(favicon.ico|apple-touch-icon.png|og-image.jpg)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": ".*\\.vercel\\.app" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    }
  ]
}
